{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zephyr:engine-result:1",
  "title": "Zephyr engine command result v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "sessionId", "phase", "status", "revision", "stateValid", "changes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "commandId": {"$ref": "urn:zephyr:engine-command:1#/$defs/id"},
    "sessionId": {"$ref": "urn:zephyr:engine-command:1#/$defs/id"},
    "phase": {"enum": ["preview", "apply", "undo"]},
    "status": {"enum": ["previewed", "applied", "undone", "rejected"]},
    "revision": {"$ref": "urn:zephyr:engine-command:1#/$defs/revision"},
    "stateValid": {"type": "boolean"},
    "transactionId": {"$ref": "urn:zephyr:engine-command:1#/$defs/id"},
    "changes": {"type": "array", "maxItems": 256, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["operationIndex", "target", "property", "before", "after", "label", "beforeDisplay", "afterDisplay"],
      "properties": {
        "operationIndex": {"type": "integer", "minimum": 0, "maximum": 255},
        "target": {"$ref": "urn:zephyr:engine-command:1#/$defs/target"},
        "property": {"type": "string", "minLength": 1, "maxLength": 128},
        "before": {"$ref": "urn:zephyr:engine-command:1#/$defs/value"},
        "after": {"$ref": "urn:zephyr:engine-command:1#/$defs/value"},
        "unit": {"type": "string", "maxLength": 32},
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "beforeDisplay": {"type": "string", "maxLength": 100},
        "afterDisplay": {"type": "string", "maxLength": 100}
      }
    }},
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "recoverable", "path"],
      "properties": {
        "code": {"enum": ["INVALID_COMMAND", "UNSUPPORTED_VERSION", "UNKNOWN_SESSION", "TARGET_NOT_FOUND", "CONTROL_NOT_FOUND", "VALUE_OUT_OF_RANGE", "UNSUPPORTED_OPERATION", "CONFLICT", "AUTOMATION_CONFLICT", "UNDO_CONFLICT", "ENGINE_UNAVAILABLE", "ENGINE_FAILURE", "IDEMPOTENCY_CONFLICT"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 500},
        "recoverable": {"type": "boolean"},
        "path": {"type": "string", "maxLength": 256, "pattern": "^(?:/(?:[^~/]|~[01])*)*$"},
        "operationIndex": {"type": "integer", "minimum": 0, "maximum": 255},
        "target": {"$ref": "urn:zephyr:engine-command:1#/$defs/target"},
        "expected": {"$ref": "urn:zephyr:engine-command:1#/$defs/value"},
        "actual": {"$ref": "urn:zephyr:engine-command:1#/$defs/value"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["previewed", "applied", "undone"]}}}, "then": {"properties": {"stateValid": {"const": true}}}},
    {"if": {"properties": {"stateValid": {"const": false}}}, "then": {"properties": {"status": {"const": "rejected"}, "error": {"properties": {"code": {"const": "ENGINE_FAILURE"}}}}}}
  ],
  "oneOf": [
    {"properties": {"status": {"const": "previewed"}, "phase": {"const": "preview"}}, "not": {"anyOf": [{"required": ["error"]}, {"required": ["transactionId"]}]}},
    {"properties": {"status": {"const": "applied"}, "phase": {"const": "apply"}}, "required": ["transactionId"], "not": {"required": ["error"]}},
    {"properties": {"status": {"const": "undone"}, "phase": {"const": "undo"}}, "required": ["transactionId"], "not": {"required": ["error"]}},
    {"properties": {"status": {"const": "rejected"}, "changes": {"maxItems": 0}}, "required": ["error"], "not": {"required": ["transactionId"]}}
  ]
}
